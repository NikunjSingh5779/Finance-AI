# LLM Provider API Keys — set at least one
# Priority order: OMNIROUTE (Haiku only) → OPENCODE → OPENROUTER → CLAUDE → OPENAI

# OmniRoute localhost provider (highest priority) - Haiku combo models only
# OMNIROUTE_API_KEY=your-omniroute-key-here
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128  # Optional override

OPENCODE_ZEN_API_KEY=your-opencode-zen-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENAI_API_KEY=your-openai-key-here
# CLAUDE_API_KEY=your-claude-key-here

# Optional: override model names
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

# Production database (Supabase Postgres connection string)
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Local-only SQLite fallback (ignored when DATABASE_URL is set)
DB_PATH=finance.db

# CORS origins (comma-separated; use explicit trusted origins in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit for AI endpoints (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10
