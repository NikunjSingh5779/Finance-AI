# FinanceAI — environment configuration

# ---------------- Authentication / multi-user ----------------
# Create a Supabase project and enable Email/Password Auth.
# Render/production should set AUTH_REQUIRED=true.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AUTH_REQUIRED=true

# Optional when using legacy HS256 JWT signing. Prefer Supabase asymmetric
# signing keys; the backend verifies them through the JWKS endpoint.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ---------------- Database ----------------
# Production: Supabase PostgreSQL connection string.
# Local development can leave this unset and use DB_PATH instead.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DB_PATH=finance.db

# Existing local/test deployments can use this stable dev identity when
# AUTH_REQUIRED=false.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---------------- AI providers ----------------
# Local Windows OmniRoute:
# OMNIROUTE_API_KEY=your-omniroute-api-key
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_COMBO_NAME=your-combo-name
# OMNIROUTE_MODEL=your-combo-name

# OpenCode Zen:
# OPENCODE_ZEN_API_KEY=your-opencode-key
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=mimo-v2.6-flash-free

# Cloud/free-first OpenRouter:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---------------- HTTP / frontend ----------------
PORT=8000
RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$|^https://[a-z0-9][a-z0-9-]*\.netlify\.app$|^https://([a-z0-9-]+\.)?finance-ai-61h\.pages\.dev$
