# FinanceAI — environment configuration

# ---------------- Authentication / multi-user ----------------
# Create a Supabase project and enable Email/Password Auth.
# Render/production should set AUTH_REQUIRED=true.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
AUTH_REQUIRED=true

# Signs the HttpOnly refresh-token cookie (7-day session). REQUIRED in
# production (the app refuses to start without it): at least 32 random
# characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every user out. Local development falls back to a fixed
# insecure value when this is unset.
SESSION_COOKIE_SECRET=

# Optional when using legacy HS256 JWT signing. Prefer Supabase asymmetric
# signing keys; the backend verifies them through the JWKS endpoint.
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# ---------------- Database ----------------
# Production: Supabase PostgreSQL connection string.
# Local development can leave this unset and use DB_PATH instead.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DB_PATH=finance.db

# Existing local/test deployments can use this stable dev identity when
# AUTH_REQUIRED=false.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# ---------------- AI providers ----------------
# Groq Free tier. Keep your Groq account on the Free plan to avoid
# usage-based billing. FinanceAI only allows the current free chat models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM API Catalog. Free Developer Program access is for development,
# prototyping and testing. Public production use requires NVIDIA AI Enterprise.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
NVIDIA_NIM_MODELS=openai/gpt-oss-20b
# Set true only when this deployment has a production-eligible NIM license.
NVIDIA_NIM_PRODUCTION_LICENSED=false

# OpenRouter free-model router and catalogue-verified free fallbacks.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---------------- HTTP / frontend ----------------
PORT=8000
RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$|^https://([a-z0-9-]+\.)?finance-ai-61h\.pages\.dev$
