# FinanceAI — optional AI provider configuration
# Configure at least one provider if you want AI features.

# Local OmniRoute (OpenAI Responses-compatible)
# For FinanceAI running directly on Windows:
# OMNIROUTE_API_KEY=your-omniroute-api-key
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Use the exact combo name created in OmniRoute. FinanceAI will not auto-select
# arbitrary proxy models when this provider is enabled.
# OMNIROUTE_COMBO_NAME=your-combo-name
# OMNIROUTE_MODEL=your-combo-name

# OpenCode Zen
# OPENCODE_ZEN_API_KEY=your-opencode-key
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=mimo-v2.5-free

# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODEL=openrouter/free

# SQLite database path
DB_PATH=finance.db

# Browser origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# Allow local development and Netlify-hosted frontend sites.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$|^https://[a-z0-9][a-z0-9-]*\.netlify\.app$

# AI request limit per minute and IP
RATE_LIMIT_PER_MINUTE=10
