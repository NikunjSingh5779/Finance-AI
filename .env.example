# LLM Provider API Keys — set at least one
# Priority order: OPENCODE → OPENROUTER → CLAUDE → OPENAI
OPENCODE_ZEN_API_KEY=your-opencode-zen-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENAI_API_KEY=your-openai-key-here
# CLAUDE_API_KEY=your-claude-key-here

# Optional: override model names
# CLAUDE_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini

# Database path (default: finance.db)
DB_PATH=finance.db

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# Rate limit for AI endpoints (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10
